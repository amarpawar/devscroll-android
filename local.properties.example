# Copy the keys below into local.properties (gitignored) and fill in real values.
# app/build.gradle.kts turns them into string resources at build time; a missing
# key becomes an empty string, so the app still builds but that sign-in path fails.

# Google OAuth web client ID (Google Cloud console > Credentials).
GOOGLE_WEB_CLIENT_ID=


# Release signing. Path is relative to the repo root. Leave blank for debug-only
# work — release builds then produce an unsigned APK instead of failing the build.
# Generate the keystore with:
#   keytool -genkeypair -v -keystore devscroll-release.jks \
#     -alias devscroll -keyalg RSA -keysize 2048 -validity 10000
# Keep the .jks out of git (it is gitignored) and back it up somewhere durable:
# losing it means you can never publish an update to this app again.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
