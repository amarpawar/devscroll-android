<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Access and refresh tokens must never be uploaded to cloud backup. -->
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Nor restored onto a different device during transfer. -->
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
